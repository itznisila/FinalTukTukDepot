<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="gui.CartController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Code:" />
            <TextField fx:id="codeField" />
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label text="Quantity:" />
            <TextField fx:id="quantityField" />
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="50.0">
         <children>
            <Button fx:id="addToCartButton" mnemonicParsing="false" onAction="#handleAddToCart" text="Add to cart" />
            <Button fx:id="emptyCartButton" mnemonicParsing="false" onAction="#handleEmptyCart" text="Empty cart" />
         </children>
      </HBox>
      <TableView fx:id="cartTable" prefHeight="250.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="codeColumn" prefWidth="75.0" text="Code" />
          <TableColumn fx:id="nameColumn" prefWidth="75.0" text="Name" />
            <TableColumn fx:id="quantityColumn" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="subTotalColumn" prefWidth="75.0" text="Sub Total" />
        </columns>
      </TableView>
      <Button fx:id="checkoutButton" mnemonicParsing="false" onAction="#handleCheckout" text="Checkout" />
      <Label fx:id="feedbackLabel" />
   </children>
</VBox>
